# Keep development-only files out of the distributed package. Everything below
# is useful in the repository but is dead weight in a consumer's vendor/ dir.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/tests              export-ignore
/phpunit.xml        export-ignore
/CONTRIBUTING.md    export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md        export-ignore

# README and LICENSE deliberately ship: the licence is a legal requirement and
# the readme is what users read from inside vendor/ or on Packagist.
